# ============================================================
# ORION-AI Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Provider ---
# Options: ollama | openai | gemini
LLM_PROVIDER=ollama

# If using Ollama (local LLM - FREE, recommended)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# If using OpenAI instead (comment out Ollama above)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# If using Gemini instead (comment out Ollama above)
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- Vector Database (Qdrant) ---
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=orion_knowledge

# --- Jira Integration (optional but recommended) ---
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=KAN
